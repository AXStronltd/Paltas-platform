{
  "name": "paltas-app",
  "version": "0.1.0",
  "private": true,
  "description": "PALTAS Smart Living — API-ready product frontend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "test:auth": "tsc -p tsconfig.test.json && node --test tests/*.test.js",
    "audit:routes": "node scripts/audit-routes.mjs",
    "test:e2e": "npm run db:seed --silent && node tests/permissions.e2e.mjs",
    "verify": "npm run typecheck && npm run test:auth && npm run audit:routes && npm run audit:layers",
    "test:platform": "npm run db:seed --silent && node tests/platform.e2e.mjs",
    "test:all": "npm run test:auth && npm run test:e2e && npm run test:platform && npm run test:commerce && npm run test:finance && npm run test:publishing",
    "test:commerce": "npm run db:seed --silent && node tests/commerce.e2e.mjs",
    "test:finance": "npm run db:seed --silent && node tests/finance.e2e.mjs",
    "test:publishing": "npm run db:seed --silent && node tests/publishing.e2e.mjs",
    "audit:layers": "node scripts/audit-layers.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.10.0",
    "@supabase/supabase-js": "^2.112.4",
    "next": "14.2.5",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.7.0",
    "@types/node": "20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.3"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
