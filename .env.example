# PALTAS environment variables

# ============================================================
# Marketplace side (listings, bookings, escrow) — unchanged
# ============================================================

# Show the demo catalogue — six invented properties that cannot be booked, plus
# a generated feed for the discovery rows. For local development only.
#
# Leave this UNSET anywhere the public can reach it. Set to "true" and the
# shopfront mixes fiction into real inventory, with no way for a visitor to
# tell which is which.
# NEXT_PUBLIC_DEMO_CATALOGUE=true

# --- Supabase Auth --------------------------------------------------------
# Public values are safe in browser code. Set both public variables in Render.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Browser key for Places Autocomplete and the property map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-only values. The service key must never use a NEXT_PUBLIC_ name.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
#
# This block used to be headed "REAL login + database", which was untrue in
# both halves and is left here saying so because the claim caused real
# confusion: it reads as though accounts are waiting on a Supabase project,
# when sign-in, sessions, roles and approvals are already real and already
# work. They are served by this application against DATABASE_URL below:
#
#   passwords   scrypt, src/server/password.ts
#   sessions    a random token in an httpOnly cookie, only its SHA-256 stored,
#               src/server/session.ts
#   accounts    signup → PENDING → a Paltas admin approves → a role is granted,
#               src/app/api/auth/signup + src/app/api/platform/approvals
#   RBAC        roles, scopes and per-user grants, src/server/actor.ts
#
# Supabase can also host the Postgres database. Put its connection string in
# DATABASE_URL; Prisma uses that connection independently of Supabase Auth.

# Payment provider PUBLISHABLE key. Safe in the browser — it can only create,
# never charge. Anything beginning sk_ or rk_ must NEVER be given a NEXT_PUBLIC_
# name: Next.js compiles those into the JavaScript served to every visitor.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================
# Management side — portfolio, staff permissions, Paltas Security Management
# ============================================================

# Postgres connection for the management database. This one is server-only and
# must never be prefixed NEXT_PUBLIC_ — it would ship to the browser if it were.
#
#   Local:   postgresql://postgres:postgres@localhost:5432/paltas
#   Supabase: use the "Connection string → URI" from Settings → Database
#   Neon / Railway / RDS: their connection string, with ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paltas

# Password given to every account created by `npm run db:seed`.
# Change it, or leave it unset to accept the default demo password.
SEED_PASSWORD=

# ============================================================
# Stripe — server-side only
# ============================================================

# The secret key. Server-only: it is read by src/server/stripe.ts and never
# leaves the process. sk_live_ moves real money; sk_test_ does not.
#
#   NEVER commit this, paste it into a chat, a ticket, or a screenshot.
#   If it is ever exposed, roll it immediately:
#   Stripe Dashboard -> Developers -> API keys -> Roll key.
#
# The app refuses to start a payment if a secret key is found in any
# NEXT_PUBLIC_ variable, because that would ship it to the browser.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint (Stripe Dashboard -> Developers ->
# Webhooks -> your endpoint -> Signing secret). Without it, /api/payments/webhook
# rejects every delivery — which is the correct default: an unverified webhook is
# a stranger asserting that a payment succeeded.
#
# Point the endpoint at:  https://your-domain/api/payments/webhook
# Events to send: payment_intent.succeeded, payment_intent.payment_failed,
#                 payment_intent.processing, charge.refunded
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Stripe Connect (multiple property owners)
# ------------------------------------------------------------
# No extra variable is needed. Connect is per-organisation and lives in the
# database, not the environment:
#
#   Organization.stripeAccountId         acct_… once the owner has onboarded
#   Organization.stripeOnboarded         false until Stripe confirms it
#   Organization.platformFeeBasisPoints  what PALTAS retains (250 = 2.5%)
#
# With those set, /api/payments/intent issues a destination charge: the money
# settles into the owner's account and Stripe deducts the platform fee. With
# them unset, the identical code path charges the platform account — so
# switching an owner on is a data change, not a deploy.

# --- External listing sources -------------------------------------------
# Only needed if you ingest third-party inventory. Absent, syncs fail cleanly
# and nothing is published. Read EXTERNAL-LISTINGS.md before switching this on:
# fetching is not the same as having the right to display.
APIFY_TOKEN=
APIFY_TRUEFETCH_DATASET_ID=
APIFY_TRUEFETCH_ACTOR_ID=

# --- Payouts ---------------------------------------------------------------
# How long a host's money is held after check-out before it can be sent, and
# how little is worth a transfer. The hold is a promise to the guest: it is what
# gives them somewhere to complain from if the property is not as advertised.
PAYOUT_HOLD_DAYS=1
PAYOUT_MINIMUM=100

# The credential the payout cron presents, since a scheduler has no session.
# Generated by Render in production — see render.yaml. 32 characters minimum:
# below that the endpoint disables the token path entirely, so a half-configured
# deployment pays nobody rather than paying anybody who asks.
PAYOUT_RUN_TOKEN=

# --- Photo storage (S3-compatible) -----------------------------------------
# Cloudflare R2, Amazon S3, Backblaze B2, Supabase Storage or MinIO — nothing
# here is specific to one of them. Without these, photo upload is switched off
# and says so; nothing else on the platform is affected.
#
# S3_PUBLIC_URL SHOULD BE A DIFFERENT HOST FROM THE APPLICATION. Even with the
# byte-level checks in src/lib/media/images.ts, serving files that strangers
# uploaded from the origin that holds session cookies is a standing risk. A
# separate host means the worst case is an odd file on a domain with nothing to
# steal. On R2 that is a custom domain or the r2.dev URL; on S3, CloudFront.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Email
#
# Without these, nothing is sent and the password-reset endpoint hands the link
# back in its response instead — deliberately, so a deployment that cannot send
# email does not lock people out silently. See src/server/mail.ts.
#
# SMTP_URL is NOT read. Only Resend is implemented; setting an SMTP variable
# would not send anything and must not look like configuration.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain verified with the provider, or every send is
# refused. A display name is optional: "PALTAS <bookings@paltas.io>".
MAIL_FROM=PALTAS <bookings@paltas.io>
# Shared secret for the scheduled outbox flush. At least 32 characters, or the
# token path is disabled entirely rather than left satisfiable by anyone.
MAIL_FLUSH_TOKEN=

# ---------------------------------------------------------------------------
# Help assistant (Claude)
#
# Server-side only. This key must NEVER appear in a NEXT_PUBLIC_ variable —
# Next.js compiles those into JavaScript served to every visitor, and a key that
# has been served cannot be recalled. The route refuses to run if it finds one.
#
# Without ANTHROPIC_API_KEY the "?" in the header still appears and the panel
# says the assistant is not switched on, rather than failing silently.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional. Change or roll back the model without a deploy.
ANTHROPIC_MODEL=claude-sonnet-5
# Optional. Salts the digest used to count requests per caller, so the same
# person is not identifiable across deployments. Falls back to another secret.
SUPPORT_HASH_SALT=
