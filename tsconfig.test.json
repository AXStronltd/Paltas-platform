{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-build",
    "incremental": false,
    "jsx": "react-jsx",
    "rootDir": "src",
    "paths": {
      "@/lib/*": [
        "src/lib/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/lib/security/**/*.ts",
    "src/lib/security/**/*.json",
    "src/lib/pricing/**/*.ts",
    "src/lib/services/pricingService.ts",
    "src/lib/models/index.ts",
    "src/lib/loyalty/**/*.ts",
    "src/server/stripe.ts",
    "src/lib/i18n/**/*.ts",
    "src/lib/i18n/**/*.json",
    "src/lib/booking/**/*.ts",
    "src/lib/external/**/*.ts",
    "src/lib/marketplace/**/*.ts",
    "src/lib/payouts/**/*.ts",
    "src/lib/media/**/*.ts",
    "src/lib/mail/**/*.ts",
    "src/lib/support/**/*.ts",
    "src/server/storage.ts",
    "src/lib/search/**/*.ts"
  ]
}
