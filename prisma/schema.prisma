// PALTAS — data model.
//
// The marketplace side of PALTAS (listings, bookings, escrow) stays where it is:
// in the service layer, backed by mock data or Supabase. What lives here is the
// side of the product that must never be guessed at — the property portfolio and
// Paltas Security Management — because every read and write against it is
// authorised on the server against the permission model below.
//
// The authorisation spine is: Organization -> Property -> Building -> Unit.
// Every grant is pinned to one node of that tree and inherits downward, which is
// what makes "staff see only what they are assigned to" a property of the data
// model rather than a rule the UI is trusted to remember.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHORISATION SPINE
// ============================================================

enum ScopeType {
  ORGANIZATION
  PROPERTY
  BUILDING
  UNIT
}

enum Effect {
  ALLOW
  DENY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  /// Signed up, awaiting a decision. Can sign in and do nothing: the
  /// authorization engine refuses every non-ACTIVE status, so a pending
  /// account is safe by construction rather than by remembering to check.
  PENDING
  /// Turned down. Kept rather than deleted so the same person cannot simply
  /// sign up again and land in the queue as if nothing happened.
  REJECTED
}

model Organization {
  id         String  @id @default(cuid())
  name       String
  country    String  @default("KE")
  currency   String  @default("KES")
  /// True for the single organisation that holds Paltas's own staff. It owns no
  /// properties and is excluded from every tenant-facing listing.
  isPlatform Boolean @default(false)
  /// False until a Paltas administrator approves the account that created it.
  /// A pending organisation exists so its owner has somewhere to belong; it
  /// holds no properties and its users can do nothing until approved.
  approved   Boolean @default(true)

  /// Stripe Connect: the connected account money is settled into for this
  /// property owner. Null until they complete onboarding, at which point
  /// payments for their properties route to them with PALTAS taking an
  /// application fee, rather than landing in one pooled balance that then has to
  /// be reconciled and paid out by hand.
  stripeAccountId        String?  @unique
  stripeOnboarded        Boolean  @default(false)
  /// Basis points PALTAS retains on payments to this account (250 = 2.5%).
  platformFeeBasisPoints Int      @default(0)
  createdAt              DateTime @default(now())

  users            User[]
  roles            Role[]
  properties       Property[]
  auditLogs        AuditLog[]
  campaigns        Campaign[]
  discounts        Discount[]
  groups           GroupBooking[]
  loyalty          LoyaltyMember[]
  listings         PropertyListing[]
  feeCategories    FeeCategory[]
  earnings         HostEarning[]
  payouts          Payout[]
  charges          Charge[]
  salaries         SalaryProfile[]
  payRuns          PayRun[]
  leads            Lead[]
  viewings         Viewing[]
  projects         Project[]
  serviceOfferings ServiceOffering[]
}

/// Every human the system authenticates: the owner, staff, guards and the
/// residents who raise their own visitor invitations. `isOwner` is deliberately
/// a column and not a role, so that no amount of role or permission editing by
/// staff can manufacture owner authority.
///
/// `isPlatformAdmin` is the same idea one level up: Paltas staff who operate the
/// service itself and whose authority crosses organisations. It is the only
/// thing in the system that does, which is why it is a column too — nothing a
/// tenant can edit should be able to produce it.
model User {
  id              String     @id @default(cuid())
  orgId           String
  email           String     @unique
  supabaseUserId  String?    @unique
  name            String
  phone           String?
  passwordHash    String
  isOwner         Boolean    @default(false)
  isPlatformAdmin Boolean    @default(false)
  status          UserStatus @default(ACTIVE)
  title           String?
  /// What they said they are, at signup: landlord, agent, hotel, developer.
  /// A request, not a grant — the role that decides anything is assigned on
  /// approval, by somebody who checked.
  requestedRole   String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedReason  String?
  onboardingCompletedAt DateTime?
  onboardingRole String?
  onboardingData Json?
  createdAt       DateTime   @default(now())
  createdById     String?

  org             Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers    User[]            @relation("UserCreatedBy")
  roleAssignments RoleAssignment[]
  grants          PermissionGrant[]
  sessions        Session[]
  guard           Guard?
  resident        Resident?
  salaryProfiles  SalaryProfile[]
  payslips        Payslip[]
  verificationDocuments VerificationDocument[]
  messageThreads        MessageThread[]
  notifications         Notification[]

  @@index([orgId])
}

enum VerificationDocumentType {
  IDENTITY
  OWNERSHIP
  SUPPORTING
}

enum VerificationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationDocument {
  id           String                     @id @default(cuid())
  userId       String
  type         VerificationDocumentType
  storageKey   String                     @unique
  fileName     String
  contentType  String
  size         Int
  status       VerificationDocumentStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A named bundle of permissions. System roles (Property Manager, Security
/// Manager, Security Guard, Maintenance, Accountant) ship as seed data; an
/// organisation can add its own. A role is only ever a starting point — the
/// per-user grants below can add to it or carve holes in it.
model Role {
  id          String  @id @default(cuid())
  orgId       String?
  key         String
  name        String
  description String?
  isSystem    Boolean @default(false)

  org         Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([orgId, key])
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

/// "This user holds this role, but only over this part of the tree."
/// A Security Manager assigned at PROPERTY scope for Property A has no reach
/// into Property B, and nothing in the API needs to remember that specially.
model RoleAssignment {
  id          String    @id @default(cuid())
  userId      String
  roleId      String
  scopeType   ScopeType
  scopeId     String
  createdAt   DateTime  @default(now())
  grantedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
}

/// A single permission switched on or off for one user, at one scope.
/// This is what makes the system not merely role-driven: John can hold the
/// Security Guard role and additionally be granted `resident.view`, or be
/// explicitly denied `visitor.approve`, without inventing a new role for him.
model PermissionGrant {
  id          String    @id @default(cuid())
  userId      String
  permission  String
  effect      Effect    @default(ALLOW)
  scopeType   ScopeType
  scopeId     String
  createdAt   DateTime  @default(now())
  grantedById String?
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission, scopeType, scopeId])
  @@index([userId])
}

// ============================================================
// PORTFOLIO
// ============================================================

enum UnitStatus {
  OCCUPIED
  VACANT
  NOTICE
  MAINTENANCE
}

model Property {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  address   String?
  city      String?
  country   String   @default("KE")
  kind      String   @default("residential")
  /// Where this actually is, once somebody has geocoded it.
  ///
  /// Null until then, and everything that reads it must cope with that: a
  /// property with no coordinates is simply absent from distance-ranked
  /// results rather than being placed at nought degrees north. Backfilled by
  /// scripts/backfill-coordinates.mjs from the address the host typed.
  latitude  Float?
  longitude Float?
  /// The Google place this resolved to, so a re-geocode can be skipped and a
  /// selected destination can be matched against inventory by place rather
  /// than by string.
  placeId   String?
  createdAt DateTime @default(now())

  org              Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  buildings        Building[]
  units            Unit[]
  residents        Resident[]
  visitors         Visitor[]
  invitations      VisitorInvitation[]
  visits           VisitorVisit[]
  cards            AccessCard[]
  vehicles         Vehicle[]
  gates            Gate[]
  guards           Guard[]
  shifts           GuardShift[]
  incidents        SecurityIncident[]
  alerts           EmergencyAlert[]
  accessEvents     AccessEvent[]
  maintenance      MaintenanceRequest[]
  payments         Payment[]
  expenses         Expense[]
  campaigns        Campaign[]
  discounts        Discount[]
  groups           GroupBooking[]
  feeCategories    FeeCategory[]
  charges          Charge[]
  salaries         SalaryProfile[]
  payRuns          PayRun[]
  listings         PropertyListing[]
  bookings         Booking[]
  roomTypes        HotelRoomType[]
  blocks           AvailabilityBlock[]
  leads            Lead[]
  viewings         Viewing[]
  projects         Project[]
  serviceOfferings ServiceOffering[]

  @@index([orgId])
}

model Building {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  floors     Int      @default(1)
  createdAt  DateTime @default(now())

  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units       Unit[]
  incidents   SecurityIncident[]
  maintenance MaintenanceRequest[]

  @@index([propertyId])
}

/// `propertyId` is denormalised onto Unit (and onto every security record) on
/// purpose: scope filtering runs on nearly every request, and it should never
/// need a join to answer "which property does this row belong to?".
model Unit {
  id         String     @id @default(cuid())
  buildingId String
  propertyId String
  name       String
  floor      Int?
  bedrooms   Int?
  rentAmount Int?
  currency   String     @default("KES")
  status     UnitStatus @default(VACANT)
  createdAt  DateTime   @default(now())

  building     Building             @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents    Resident[]
  invitations  VisitorInvitation[]
  visits       VisitorVisit[]
  cards        AccessCard[]
  vehicles     Vehicle[]
  incidents    SecurityIncident[]
  accessEvents AccessEvent[]
  maintenance  MaintenanceRequest[]
  payments     Payment[]
  charges      Charge[]
  listings     PropertyListing[]
  bookings     Booking[]
  leads        Lead[]
  viewings     Viewing[]

  @@index([propertyId])
  @@index([buildingId])
}

enum ResidentType {
  OWNER_OCCUPIER
  TENANT
  FAMILY_MEMBER
}

model Resident {
  id         String       @id @default(cuid())
  unitId     String
  propertyId String
  userId     String?      @unique
  fullName   String
  email      String?
  phone      String?
  type       ResidentType @default(TENANT)
  isPrimary  Boolean      @default(false)
  moveInAt   DateTime?
  moveOutAt  DateTime?
  leaseEnd   DateTime?
  active     Boolean      @default(true)

  unit        Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitations VisitorInvitation[]
  cards       AccessCard[]
  vehicles    Vehicle[]
  payments    Payment[]
  maintenance MaintenanceRequest[]
  charges     Charge[]

  @@index([propertyId])
  @@index([unitId])
}

// ============================================================
// PALTAS SECURITY MANAGEMENT
// ============================================================

enum VisitorType {
  FAMILY_FRIEND
  DELIVERY
  CONTRACTOR
  DOMESTIC_WORKER
  DRIVER
  OTHER
}

enum InvitationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  USED
}

enum VisitStatus {
  ON_SITE
  CHECKED_OUT
  DENIED
}

/// A person known to the property. Kept separate from the invitation so a
/// regular visitor — the domestic worker who comes daily, the courier who comes
/// weekly — has one identity and one searchable history rather than one row per
/// arrival.
model Visitor {
  id              String      @id @default(cuid())
  propertyId      String
  fullName        String
  phone           String?
  idType          String?
  idNumber        String?
  type            VisitorType @default(FAMILY_FRIEND)
  company         String?
  photoUrl        String?
  blacklisted     Boolean     @default(false)
  blacklistReason String?
  createdAt       DateTime    @default(now())

  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  invitations VisitorInvitation[]
  visits      VisitorVisit[]
  vehicles    Vehicle[]
  incidents   SecurityIncident[]

  @@index([propertyId])
  @@index([propertyId, fullName])
}

/// The invitation a resident (or an authorised staff member) raises ahead of a
/// visit. `qrToken` is the secret behind the QR pass; `passCode` is the short
/// human-readable fallback a guard can type when a phone screen won't scan.
/// Recurring passes carry `maxUses` and count down, so a contractor's week-long
/// pass expires on its own rather than living forever.
model VisitorInvitation {
  id             String           @id @default(cuid())
  propertyId     String
  unitId         String
  residentId     String?
  visitorId      String?
  visitorName    String
  visitorPhone   String?
  visitorType    VisitorType      @default(FAMILY_FRIEND)
  purpose        String?
  validFrom      DateTime
  validTo        DateTime
  recurring      Boolean          @default(false)
  recurrenceRule String?
  maxUses        Int              @default(1)
  useCount       Int              @default(0)
  passCode       String           @unique
  qrToken        String           @unique
  vehiclePlate   String?
  status         InvitationStatus @default(PENDING)
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime         @default(now())

  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit         Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident     Resident?      @relation(fields: [residentId], references: [id], onDelete: SetNull)
  visitor      Visitor?       @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  visits       VisitorVisit[]
  accessEvents AccessEvent[]

  @@index([propertyId, status])
  @@index([unitId])
}

/// One arrival. Created at check-in and closed at check-out, so "who is on site
/// right now" is a single indexed query rather than a reconstruction from events.
model VisitorVisit {
  id           String      @id @default(cuid())
  propertyId   String
  unitId       String?
  invitationId String?
  visitorId    String?
  visitorName  String
  visitorPhone String?
  visitorType  VisitorType @default(FAMILY_FRIEND)
  gateId       String?
  badgeNo      String?
  vehiclePlate String?
  checkInAt    DateTime    @default(now())
  checkInById  String?
  checkOutAt   DateTime?
  checkOutById String?
  status       VisitStatus @default(ON_SITE)
  notes        String?

  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit       Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  invitation VisitorInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  visitor    Visitor?           @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  gate       Gate?              @relation(fields: [gateId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([propertyId, checkInAt])
}

enum CardType {
  RESIDENT
  FAMILY
  STAFF
  TEMPORARY
  CONTRACTOR
}

enum CardStatus {
  ACTIVE
  SUSPENDED
  LOST
  EXPIRED
  REVOKED
}

model AccessCard {
  id            String     @id @default(cuid())
  propertyId    String
  unitId        String?
  residentId    String?
  holderName    String
  cardNumber    String     @unique
  type          CardType   @default(RESIDENT)
  status        CardStatus @default(ACTIVE)
  accessZones   String[]   @default([])
  issuedAt      DateTime   @default(now())
  expiresAt     DateTime?
  issuedById    String?
  suspendedAt   DateTime?
  suspendedById String?
  suspendReason String?

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit         Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  resident     Resident?     @relation(fields: [residentId], references: [id], onDelete: SetNull)
  accessEvents AccessEvent[]

  @@index([propertyId, status])
}

enum VehicleType {
  RESIDENT
  VISITOR
  STAFF
  DELIVERY
}

model Vehicle {
  id         String      @id @default(cuid())
  propertyId String
  unitId     String?
  residentId String?
  visitorId  String?
  plate      String
  make       String?
  model      String?
  colour     String?
  type       VehicleType @default(RESIDENT)
  permitNo   String?
  parkingBay String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())

  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit         Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  resident     Resident?          @relation(fields: [residentId], references: [id], onDelete: SetNull)
  visitor      Visitor?           @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  incidents    SecurityIncident[]
  accessEvents AccessEvent[]

  @@unique([propertyId, plate])
  @@index([propertyId])
}

enum GateKind {
  MAIN
  PEDESTRIAN
  SERVICE
  PARKING
}

model Gate {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  kind       GateKind @default(MAIN)
  isActive   Boolean  @default(true)

  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  shifts       GuardShift[]
  visits       VisitorVisit[]
  accessEvents AccessEvent[]

  @@index([propertyId])
}

model Guard {
  id          String   @id @default(cuid())
  propertyId  String
  userId      String   @unique
  badgeNumber String   @unique
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts   GuardShift[]

  @@index([propertyId])
}

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  MISSED
}

model GuardShift {
  id         String      @id @default(cuid())
  propertyId String
  guardId    String
  gateId     String?
  startsAt   DateTime
  endsAt     DateTime
  status     ShiftStatus @default(SCHEDULED)
  checkInAt  DateTime?
  checkOutAt DateTime?
  notes      String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guard    Guard    @relation(fields: [guardId], references: [id], onDelete: Cascade)
  gate     Gate?    @relation(fields: [gateId], references: [id], onDelete: SetNull)

  @@index([propertyId, startsAt])
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

model SecurityIncident {
  id              String           @id @default(cuid())
  propertyId      String
  buildingId      String?
  unitId          String?
  reference       String           @unique
  category        String
  severity        IncidentSeverity @default(MEDIUM)
  title           String
  description     String
  location        String?
  occurredAt      DateTime         @default(now())
  reportedById    String?
  reportedByName  String?
  status          IncidentStatus   @default(OPEN)
  visitorId       String?
  vehicleId       String?
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNotes String?
  createdAt       DateTime         @default(now())

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  visitor  Visitor?  @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([propertyId, occurredAt])
}

enum AlertType {
  PANIC
  FIRE
  MEDICAL
  INTRUSION
  EVACUATION
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model EmergencyAlert {
  id               String      @id @default(cuid())
  propertyId       String
  type             AlertType
  message          String?
  location         String?
  raisedById       String?
  raisedByName     String?
  status           AlertStatus @default(ACTIVE)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime    @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
}

enum AccessDirection {
  IN
  OUT
}

enum AccessMethod {
  CARD
  QR
  MANUAL
  PLATE
}

enum AccessResult {
  GRANTED
  DENIED
}

/// The immutable access history: every card tap, QR scan, plate check and manual
/// wave-through, granted or denied. Written by the same handlers that perform the
/// action, never edited afterwards.
model AccessEvent {
  id           String          @id @default(cuid())
  propertyId   String
  gateId       String?
  unitId       String?
  direction    AccessDirection @default(IN)
  method       AccessMethod
  result       AccessResult
  subjectType  String
  subjectId    String?
  subjectName  String
  cardId       String?
  invitationId String?
  vehicleId    String?
  reason       String?
  recordedById String?
  at           DateTime        @default(now())

  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  gate       Gate?              @relation(fields: [gateId], references: [id], onDelete: SetNull)
  unit       Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  card       AccessCard?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  invitation VisitorInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([propertyId, at])
}

// ============================================================
// OPERATIONS & FINANCE (what the owner dashboard aggregates)
// ============================================================

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model MaintenanceRequest {
  id             String              @id @default(cuid())
  propertyId     String
  buildingId     String?
  unitId         String?
  residentId     String?
  title          String
  description    String
  priority       MaintenancePriority @default(MEDIUM)
  status         MaintenanceStatus   @default(OPEN)
  assignedToId   String?
  raisedByName   String?
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?
  /// What was actually done. Without it the same fault gets raised three times.
  resolutionNote String?

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  resident Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
}

enum PaymentKind {
  RENT
  DEPOSIT
  SERVICE_CHARGE
  FINE
}

enum PaymentStatus {
  PAID
  DUE
  OVERDUE
}

model Payment {
  id         String        @id @default(cuid())
  propertyId String
  unitId     String?
  residentId String?
  /// Set when this payment settles a specific charge from the fee schedule.
  chargeId   String?
  kind       PaymentKind   @default(RENT)
  amount     Int
  currency   String        @default("KES")
  dueDate    DateTime
  paidAt     DateTime?
  status     PaymentStatus @default(DUE)
  reference  String?

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  resident Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  charge   Charge?   @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([chargeId])
}

model Expense {
  id           String   @id @default(cuid())
  propertyId   String
  category     String
  description  String?
  amount       Int
  currency     String   @default("KES")
  incurredAt   DateTime @default(now())
  recordedById String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, incurredAt])
}

// ============================================================
// AUDIT TRAIL
// ============================================================

/// Who did what, to which part of the portfolio, when, and what the value was
/// before and after. Written inside the same transaction as the change wherever
/// the change is a single write, so an action cannot succeed unlogged.
model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  actorName  String
  actorRole  String?
  action     String
  permission String?
  entityType String
  entityId   String?
  propertyId String?
  buildingId String?
  unitId     String?
  summary    String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  at         DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, at])
  @@index([propertyId, at])
  @@index([actorId, at])
}

// ============================================================
// PRICING — discounts and campaigns
//
// Owners, property managers and agents set these; the marketplace reads the
// live ones through a public endpoint. Kept in the same database as the
// portfolio rather than in the marketplace's mock layer, because a discount is
// a commercial commitment and needs the same authorisation and audit trail as
// anything else that moves money.
// ============================================================

enum DiscountKind {
  GROUP
  SEASONAL
  EARLY_BIRD
  LONG_STAY
  PROMO_CODE
  MEMBER
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  LIVE
  PAUSED
  ENDED
}

/// A named, scheduled bundle of discounts — "Hajj season 2027", "Long weekend
/// in Diani". Publishing is a separate permission from creating, so a junior can
/// draft a campaign without being able to put prices in front of the public.
model Campaign {
  id          String         @id @default(cuid())
  orgId       String
  propertyId  String?
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime
  bannerText  String?
  createdById String?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property  Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  discounts Discount[]

  @@index([orgId, status])
  @@index([propertyId])
}

/// One rule. `value` is a whole percent for PERCENTAGE and a minor-unit amount
/// for FIXED, so nothing is ever stored as a float — money and rounding do not
/// mix well, and a 12.5% discount is better expressed as basis points than as
/// a number that cannot be represented exactly.
model Discount {
  id          String            @id @default(cuid())
  orgId       String
  propertyId  String?
  campaignId  String?
  name        String
  description String?
  kind        DiscountKind      @default(SEASONAL)
  valueType   DiscountValueType @default(PERCENTAGE)
  /// Percent (1–100) when PERCENTAGE; minor units when FIXED.
  value       Int
  currency    String            @default("KES")
  code        String?           @unique

  /// Thresholds. A GROUP discount uses minGuests/minUnits — this is what makes
  /// "book for twelve pilgrims and the rate drops" expressible as data.
  minNights   Int?
  minGuests   Int?
  minUnits    Int?
  /// Booked this far ahead, for EARLY_BIRD.
  minLeadDays Int?

  maxRedemptions  Int?
  redemptionCount Int      @default(0)
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property?      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  campaign Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  groups   GroupBooking[]

  @@index([orgId, active])
  @@index([propertyId])
}

// ============================================================
// GROUP BOOKING & SPLIT PAYMENTS
//
// The differentiator for the journeys this platform actually serves: a Hajj or
// Umrah party, an extended family, a corporate block. One reference, many
// travellers, and each traveller paying their own share — rather than one person
// fronting the whole cost and chasing everyone else afterwards.
// ============================================================

enum GroupPurpose {
  HAJJ
  UMRAH
  FAMILY
  CORPORATE
  LEISURE
  OTHER
}

enum GroupStatus {
  DRAFT
  COLLECTING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ShareStatus {
  PENDING
  PAID
  REFUNDED
}

model GroupBooking {
  id             String       @id @default(cuid())
  orgId          String
  propertyId     String?
  reference      String       @unique
  name           String
  purpose        GroupPurpose @default(FAMILY)
  destination    String
  organiserName  String
  organiserEmail String?
  organiserPhone String?
  checkIn        DateTime
  checkOut       DateTime
  unitsRequested Int          @default(1)
  guests         Int          @default(1)
  /// Gross total in minor units, before any discount.
  totalAmount    Int
  currency       String       @default("KES")
  discountId     String?
  /// What the discount took off, stored rather than recomputed so a later
  /// change to the rule cannot silently restate what a group was quoted.
  discountAmount Int          @default(0)
  status         GroupStatus  @default(DRAFT)
  createdById    String?
  createdAt      DateTime     @default(now())
  confirmedAt    DateTime?

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  discount Discount?     @relation(fields: [discountId], references: [id], onDelete: SetNull)
  members  GroupMember[]

  @@index([orgId, status])
  @@index([propertyId])
}

/// One traveller and the share they owe. Shares are held as explicit amounts
/// rather than derived from a headcount, because groups rarely split evenly —
/// a child, a shared room, someone paying for their parents.
model GroupMember {
  id             String      @id @default(cuid())
  groupBookingId String
  name           String
  email          String?
  phone          String?
  shareAmount    Int
  shareStatus    ShareStatus @default(PENDING)
  paidAt         DateTime?
  reference      String?
  isOrganiser    Boolean     @default(false)
  createdAt      DateTime    @default(now())

  group GroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)

  @@index([groupBookingId])
}

// ============================================================
// PALTAS REWARDS — loyalty
//
// Balances are derived from a ledger rather than stored in a mutable column: a
// balance field is one bad write away from being wrong with no way to tell,
// whereas a ledger can always be re-derived and reconciled. Same reasoning as
// the audit trail.
// ============================================================

enum LoyaltyEntryKind {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

model LoyaltyMember {
  id       String   @id @default(cuid())
  orgId    String
  email    String
  name     String
  phone    String?
  joinedAt DateTime @default(now())
  active   Boolean  @default(true)

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries LoyaltyEntry[]

  @@unique([orgId, email])
  @@index([orgId])
}

model LoyaltyEntry {
  id              String           @id @default(cuid())
  memberId        String
  kind            LoyaltyEntryKind
  /// Signed: positive earns and adjustments up, negative redemptions and expiry.
  points          Int
  /// Spend that produced an EARN, in minor units. Drives rolling tier status.
  qualifyingSpend Int?
  reason          String
  reference       String?
  at              DateTime         @default(now())
  createdById     String?

  member LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, at])
}

// ============================================================
// FINANCIAL MANAGEMENT — fee categories, charges, payroll
//
// The chart of charges an estate actually runs on: rent, service charge, water,
// security levy, parking, penalties — each a configurable category rather than a
// hard-coded enum, because every property runs a slightly different book and a
// finance module that cannot express theirs is a finance module they will not use.
// ============================================================

enum FeeKind {
  INCOME
  EXPENSE
}

enum Recurrence {
  ONE_OFF
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// A line in the chart of charges. Scoped to a property or the whole
/// organisation, so a group can standardise while one estate keeps its quirks.
model FeeCategory {
  id            String     @id @default(cuid())
  orgId         String
  propertyId    String?
  code          String
  name          String
  description   String?
  kind          FeeKind    @default(INCOME)
  /// Suggested amount in minor units; a charge may still override it.
  defaultAmount Int?
  currency      String     @default("KES")
  recurrence    Recurrence @default(MONTHLY)
  taxable       Boolean    @default(false)
  active        Boolean    @default(true)
  createdById   String?
  createdAt     DateTime   @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  charges  Charge[]

  @@unique([orgId, code])
  @@index([orgId, active])
}

enum ChargeStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  WAIVED
  OVERDUE
}

/// One amount owed by one unit or resident, under one category.
model Charge {
  id           String       @id @default(cuid())
  orgId        String
  propertyId   String
  unitId       String?
  residentId   String?
  categoryId   String
  reference    String       @unique
  description  String?
  amount       Int
  currency     String       @default("KES")
  dueDate      DateTime
  periodLabel  String?
  status       ChargeStatus @default(ISSUED)
  waivedReason String?
  createdById  String?
  createdAt    DateTime     @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  resident Resident?    @relation(fields: [residentId], references: [id], onDelete: SetNull)
  category FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([propertyId, status])
  @@index([unitId])
}

enum PayRunStatus {
  DRAFT
  APPROVED
  PAID
}

/// What a staff member is paid, effective from a date. Superseded rather than
/// edited, so a payslip can always be explained by the profile in force at the
/// time it was produced.
model SalaryProfile {
  id            String   @id @default(cuid())
  orgId         String
  userId        String
  propertyId    String?
  jobTitle      String?
  grossMonthly  Int
  currency      String   @default("KES")
  effectiveFrom DateTime @default(now())
  active        Boolean  @default(true)
  bankReference String?
  createdById   String?
  createdAt     DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([orgId, active])
  @@index([userId])
}

model PayRun {
  id              String       @id @default(cuid())
  orgId           String
  propertyId      String?
  periodLabel     String
  periodStart     DateTime
  periodEnd       DateTime
  status          PayRunStatus @default(DRAFT)
  currency        String       @default("KES")
  totalGross      Int          @default(0)
  totalDeductions Int          @default(0)
  totalNet        Int          @default(0)
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  payslips Payslip[]

  @@index([orgId, status])
}

/// One person's pay for one period.
///
/// Deductions are stored as explicit named lines rather than computed by a tax
/// engine. PALTAS is not a certified payroll calculator for any jurisdiction,
/// and pretending otherwise would be worse than useless — the organisation
/// configures its own statutory lines and remains responsible for them.
model Payslip {
  id              String   @id @default(cuid())
  payRunId        String
  userId          String
  staffName       String
  jobTitle        String?
  gross           Int
  /// [{ label, amount }] — PAYE, NSSF, SHIF, advances, and anything else.
  deductions      Json
  totalDeductions Int      @default(0)
  net             Int
  currency        String   @default("KES")
  bankReference   String?
  createdAt       DateTime @default(now())

  payRun PayRun @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([payRunId, userId])
  @@index([userId])
}

// ============================================================
// PUBLISHING — owners, landlords and agents listing their properties
//
// The bridge between the management side and the marketplace. A unit in the
// portfolio becomes a listing the public can see only when someone with the
// publish permission says so, and the public projection is a separate query
// rather than a filtered view of the private record.
// ============================================================

enum ListingKind {
  STAY
  RENT
  SALE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UNPUBLISHED
  REJECTED
}

model PropertyListing {
  id          String        @id @default(cuid())
  orgId       String
  propertyId  String
  unitId      String?
  title       String
  summary     String?
  description String
  kind        ListingKind   @default(STAY)
  status      ListingStatus @default(DRAFT)

  /// Minor units. Nightly for STAY, monthly for RENT, total for SALE.
  price     Int
  currency  String   @default("KES")
  maxGuests Int      @default(2)
  bedrooms  Int      @default(1)
  bathrooms Int      @default(1)
  amenities String[] @default([])
  images    String[] @default([])
  city      String?
  location  String?
  /// ISO 3166-1 alpha-2. A listing's own country, not its landlord's: an agency
  /// in Nairobi may well be selling a flat in Lisbon, and the shopfront has to
  /// know which one the visitor is looking at.
  country   String?

  /// Who is publicly answerable for the listing — landlord, agent or developer.
  hostName String
  hostKind String @default("Landlord")

  submittedAt     DateTime?
  publishedAt     DateTime?
  publishedById   String?
  reviewedById    String?
  rejectionReason String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org              Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property         Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit             Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  bookings         Booking[]
  roomTypes        HotelRoomType[]
  blocks           AvailabilityBlock[]
  reviews          Review[]
  leads            Lead[]
  viewings         Viewing[]
  serviceOfferings ServiceOffering[]

  @@index([status, kind])
  @@index([status, country])
  @@index([status, city])
  @@index([orgId])
  @@index([propertyId])
  messageThreads MessageThread[]
}

// ============================================================
// PAYMENTS — Stripe settlement records
//
// The authoritative record of what Stripe told us, kept separately from the
// booking so a webhook arriving twice, out of order, or for something we have
// no record of is still stored rather than silently dropped.
// ============================================================

enum SettlementStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

model PaymentIntentRecord {
  id             String           @id @default(cuid())
  orgId          String?
  /// Stripe's own id — the idempotency anchor for every webhook about it.
  stripeIntentId String           @unique
  amount         Int
  currency       String
  status         SettlementStatus @default(REQUIRES_PAYMENT)
  purpose        String
  reference      String?
  listingId      String?
  groupBookingId String?
  chargeId       String?
  /// Set when a guest is paying for their own stay.
  bookingId      String?
  customerEmail  String?
  failureReason  String?
  /// The last webhook payload seen, for reconciliation when something disagrees.
  lastEvent      Json?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([reference])
}

// ============================================================
// MARKETPLACE — guests, bookings, hotel inventory
//
// A guest is a customer, not staff, and is deliberately a separate identity
// from `User`. The staff permission model scopes every grant to a node of
// Organization -> Property -> Building -> Unit; none of that means anything for
// someone booking a flat for the weekend. Conflating the two would either give
// guests a place in the staff tree they do not belong in, or bend the scoping
// rules until they stop protecting anything.
//
// The two identities meet at a Booking: it names a Guest and a PropertyListing,
// and the listing belongs to a property the staff side already governs.
// ============================================================

model Guest {
  id           String   @id @default(cuid())
  email        String   @unique
  supabaseUserId String? @unique
  name         String
  phone        String?
  passwordHash String
  /// Preferred market and language, remembered between visits.
  country      String?
  locale       String?
  createdAt    DateTime @default(now())
  active       Boolean  @default(true)

  sessions GuestSession[]
  bookings Booking[]
  reviews  Review[]
  threads  MessageThread[]
  notifications Notification[]

  @@index([email])
}

model GuestSession {
  id        String   @id @default(cuid())
  guestId   String
  /// SHA-256 of the cookie value, never the value itself.
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  REFUNDED
}

/// One stay, sale enquiry or tenancy application against a published listing.
///
/// Money is stored as the settled breakdown rather than recomputed on read: a
/// host changing their nightly rate next week must not retroactively change what
/// a guest was charged. Same reasoning as the group-booking discount.
model Booking {
  id         String  @id @default(cuid())
  reference  String  @unique
  guestId    String
  listingId  String
  propertyId String
  unitId     String?
  roomTypeId String?

  checkIn  DateTime
  checkOut DateTime
  guests   Int      @default(1)
  rooms    Int      @default(1)

  /// Settled at booking time, in minor units.
  nightlyRate    Int
  nights         Int
  subtotal       Int
  cleaningFee    Int    @default(0)
  serviceFee     Int    @default(0)
  taxes          Int    @default(0)
  discountAmount Int    @default(0)
  total          Int
  currency       String @default("KES")

  status         BookingStatus @default(PENDING)
  /// Set by the client so a retried request cannot double-book.
  idempotencyKey String        @unique
  /// Written once the guest has actually paid; a booking nobody paid for owes
  /// nobody anything.
  earning        HostEarning?
  guestNote      String?
  cancelReason   String?
  stripeIntentId String?
  createdAt      DateTime      @default(now())
  confirmedAt    DateTime?
  cancelledAt    DateTime?

  guest       Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  listing     PropertyListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit        Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  roomType    HotelRoomType?  @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  events      BookingEvent[]
  review      Review?
  addons      BookingAddon[]
  /// Add-ons, summed. Part of `total`.
  addonsTotal Int             @default(0)

  @@index([guestId, createdAt])
  @@index([propertyId, status])
  @@index([listingId, checkIn, checkOut])
}

/// Every state transition, with who caused it. A booking that changed state for
/// no recorded reason is the thing support cannot answer questions about.
model BookingEvent {
  id        String        @id @default(cuid())
  bookingId String
  status    BookingStatus
  note      String
  /// "guest", "host", "system" — the staff audit log covers staff actions.
  actor     String        @default("system")
  actorId   String?
  at        DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, at])
}

/// A hotel's sellable room types, with inventory. Distinct from `Unit`, which is
/// a specific physical address a resident lives at; a hotel sells "a Deluxe
/// King", not room 412.
model HotelRoomType {
  id          String   @id @default(cuid())
  propertyId  String
  listingId   String?
  name        String
  description String?
  /// Minor units, per night.
  rate        Int
  currency    String   @default("KES")
  totalRooms  Int
  maxGuests   Int      @default(2)
  beds        String?
  amenities   String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  property Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  listing  PropertyListing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  bookings Booking[]
  blocks   AvailabilityBlock[]

  @@index([propertyId, active])
}

/// Dates a listing or room type cannot be sold — maintenance, an owner stay, a
/// closed season. Availability is derived from bookings *plus* these, so a host
/// can withhold dates without inventing a fake booking.
model AvailabilityBlock {
  id          String   @id @default(cuid())
  propertyId  String
  listingId   String?
  roomTypeId  String?
  from        DateTime
  to          DateTime
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  property Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  listing  PropertyListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomType HotelRoomType?   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([propertyId, from, to])
}

/// Left by a guest after a completed stay, and only then — a review system that
/// accepts anything is a review system nobody believes.
model Review {
  id         String    @id @default(cuid())
  bookingId  String    @unique
  guestId    String
  listingId  String
  propertyId String
  stars      Int
  title      String?
  body       String
  hostReply  String?
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())

  booking Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest   Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  listing PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

// ---------------------------------------------------------------------------
// External listings — inventory from third parties.
//
// Kept in its own tables and NEVER written into PropertyListing. A row here is
// someone else's property, described in someone else's words, usually with
// someone else's photographs. Merging the two would make it impossible to
// answer the only question that matters in a takedown notice or an IP claim:
// which of these did we have the right to publish?
//
// Nothing here reaches the public shopfront unless its source carries a
// recorded licence that grants display rights. See src/lib/external/licence.ts
// for the gate, which is pure and machine-checked.
// ---------------------------------------------------------------------------

/// How a source's data may be used. The default is the safe one.
enum ExternalLicenceStatus {
  /// No licence. Ingest for internal analysis only; never display.
  NONE
  /// Explicitly research/pricing only. Never display.
  RESEARCH_ONLY
  /// A written licence exists. Display is governed by the flags below.
  LICENSED
}

model ExternalSource {
  id       String @id @default(cuid())
  /// Stable key used in code and config, e.g. "apify-truefetch-global".
  key      String @unique
  name     String
  /// Who operates it — "apify", "licensed-feed", "partner-api", "mls".
  provider String

  licenceStatus ExternalLicenceStatus @default(NONE)
  /// Contract reference, so a claim can be answered with a document.
  licenceRef    String?
  /// Who at the counterparty granted it, and when it was checked.
  licensedBy    String?
  licenceNote   String?
  /// Absent means no end date was agreed; a past date disables display.
  licenceExpiry DateTime?

  /// Each right is granted separately because they genuinely are.
  /// Facts (price, beds, area) are the least protected; photographs are the
  /// most, and agent contact details are personal data under GDPR.
  displayRights     Boolean  @default(false)
  imageRights       Boolean  @default(false)
  contactDataRights Boolean  @default(false)
  /// ISO country codes the licence covers. Empty means unrestricted.
  territories       String[] @default([])
  /// Attribution the licence obliges us to show.
  attribution       String?

  active     Boolean   @default(true)
  lastSyncAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  listings ExternalListing[]
  runs     ExternalSyncRun[]
}

model ExternalListing {
  id         String  @id @default(cuid())
  sourceId   String
  /// The provider's own id. Unique per source, not globally.
  externalId String
  /// Where it came from, shown to the visitor and used for takedowns.
  sourceUrl  String?
  /// The originating marketplace, when the aggregator names one.
  sourceSite String?

  title       String
  description String?
  kind        String  @default("SALE")
  price       Int?
  currency    String?
  /// Whole units, as published. Not converted.
  priceRaw    String?

  country   String?
  city      String?
  district  String?
  address   String?
  latitude  Float?
  longitude Float?

  bedrooms  Int?
  bathrooms Int?
  areaSqm   Float?
  amenities String[] @default([])
  images    String[] @default([])

  /// Personal data. Withheld unless the licence covers it.
  agentName  String?
  agentPhone String?
  agentEmail String?
  agencyName String?

  /// The untouched payload, so a mapping bug can be diagnosed without re-fetching.
  raw Json?

  /// Set by the licence gate at write time, and re-evaluated on every sync.
  /// Public queries filter on this column rather than recomputing, so a query
  /// that forgets the rule returns nothing rather than everything.
  displayable Boolean @default(false)
  /// Why it is or is not displayable, in words, for whoever asks later.
  displayNote String?

  /// Set when a rights holder asks us to take it down. Survives re-ingestion.
  suppressed       Boolean   @default(false)
  suppressedReason String?
  suppressedAt     DateTime?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// Absent from the latest sync — delisted at the source.
  goneAt      DateTime?

  source ExternalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalId])
  @@index([displayable, country])
  @@index([sourceId, lastSeenAt])
  @@index([city])
}

/// One ingestion run. Kept so "where did this row come from" always has an answer.
model ExternalSyncRun {
  id               String    @id @default(cuid())
  sourceId         String
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String    @default("RUNNING")
  fetched          Int       @default(0)
  created          Int       @default(0)
  updated          Int       @default(0)
  skipped          Int       @default(0)
  displayableCount Int       @default(0)
  error            String?
  /// Who or what started it — a user id, or "cron".
  triggeredBy      String?

  source ExternalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
}

// ---------------------------------------------------------------------------
// Sales pipeline — agents and developers.
//
// One Lead model serves both, because an agent chasing a buyer for a resale and
// a developer chasing one for an off-plan unit are the same object with a
// different target. Two near-identical tables would have drifted within a
// month.
//
// Everything here is scoped by propertyId like the rest of the platform, so a
// scoped agent sees their own pipeline and no one else's without any new
// authorisation machinery.
// ---------------------------------------------------------------------------

enum LeadStage {
  NEW
  CONTACTED
  VIEWING
  OFFER
  RESERVED
  CLOSED
  LOST
}

model Lead {
  id         String  @id @default(cuid())
  orgId      String
  /// The property this lead is about. Null while they are still only browsing.
  propertyId String?
  unitId     String?
  listingId  String?
  projectId  String?

  name         String
  email        String?
  phone        String?
  /// What they said they want, in their words.
  interestedIn String?
  /// Minor units, in the currency below. Null when they have not said.
  budget       Int?
  currency     String  @default("KES")

  stage  LeadStage @default(NEW)
  source String?
  notes  String?

  /// The staff member responsible. Null means unassigned, which is a state
  /// worth being able to see and filter on.
  assignedToId  String?
  lastContactAt DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  closedAt      DateTime?
  /// Why it was lost. The most useful field on the whole model at review time.
  lostReason    String?

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit     Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  listing  PropertyListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  project  Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  viewings Viewing[]

  @@index([orgId, stage])
  @@index([propertyId])
  @@index([assignedToId, stage])
}

enum ViewingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Viewing {
  id         String  @id @default(cuid())
  orgId      String
  leadId     String?
  propertyId String?
  unitId     String?
  listingId  String?

  /// Denormalised so a viewing still reads sensibly after a lead is deleted.
  clientName   String
  scheduledAt  DateTime
  durationMins Int           @default(30)
  status       ViewingStatus @default(SCHEDULED)
  notes        String?
  /// Recorded after the fact — did they like it, what put them off.
  outcome      String?

  agentId     String?
  createdById String?
  createdAt   DateTime @default(now())

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead     Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit     Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  listing  PropertyListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([orgId, scheduledAt])
  @@index([leadId])
}

enum ProjectStatus {
  PLANNING
  SELLING
  COMPLETED
  ON_HOLD
}

/// A development. Distinct from Property: a project is sold off-plan unit by
/// unit and may not exist yet, whereas a Property is somewhere people already
/// live and which the security and maintenance modules act on.
model Project {
  id         String  @id @default(cuid())
  orgId      String
  /// Set once built, so a completed development can be managed like any other.
  propertyId String?

  name        String
  location    String?
  city        String?
  country     String  @default("KE")
  description String?
  currency    String  @default("KES")

  status               ProjectStatus @default(PLANNING)
  /// Percent complete, 0-100. Stated by the developer, not computed.
  completion           Int           @default(0)
  startedAt            DateTime?
  expectedCompletionAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  units    ProjectUnit[]
  leads    Lead[]

  @@index([orgId, status])
}

enum ProjectUnitStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model ProjectUnit {
  id        String @id @default(cuid())
  projectId String

  unitNo    String
  type      String?
  floor     Int?
  bedrooms  Int?
  bathrooms Int?
  areaSqm   Float?
  /// Minor units, in the project's currency.
  price     Int
  status    ProjectUnitStatus @default(AVAILABLE)

  /// Who bought or reserved it, and for how much. `price` is the asking figure;
  /// this is what was actually agreed, which is frequently not the same.
  buyerName   String?
  agreedPrice Int?
  reservedAt  DateTime?
  soldAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, unitNo])
  @@index([projectId, status])
}

// ---------------------------------------------------------------------------
// The whole trip, not just the room.
//
// A guest arriving somewhere unfamiliar needs a bed, a way in from the airport,
// and often a cleaner or a driver while they are there. Every other platform
// makes that three transactions with three companies, and hands off the two
// that are hardest to arrange in an unfamiliar country. Here they are one
// booking and one payment.
//
// Modelled as offerings a host publishes and add-ons a guest selects, rather
// than as fixed fields, because what makes sense to offer differs enormously:
// an airport transfer in Mombasa, a ski pass in Åre, a driver in Riyadh.
// ---------------------------------------------------------------------------

enum ServiceKind {
  AIRPORT_TRANSFER
  CAR_HIRE
  DRIVER
  CLEANING
  LAUNDRY
  BREAKFAST
  CHEF
  TOUR
  CHILDCARE
  OTHER
}

/// How the price is worked out — the difference between a £40 transfer and
/// £40 a day for a driver is the whole bill.
enum ServicePricing {
  /// Once, whatever the length of stay.
  FLAT
  /// Multiplied by nights.
  PER_NIGHT
  /// Multiplied by guests.
  PER_GUEST
  /// Multiplied by both.
  PER_GUEST_NIGHT
}

model ServiceOffering {
  id         String  @id @default(cuid())
  orgId      String
  /// Offered at one property, or across the organisation when null.
  propertyId String?
  listingId  String?

  kind        ServiceKind
  name        String
  description String?
  /// Minor units, in the currency below.
  price       Int
  currency    String         @default("KES")
  pricing     ServicePricing @default(FLAT)

  /// Some services cannot be arranged same-day. Stated so a guest is not sold
  /// a 6am transfer at midnight.
  noticeHours   Int  @default(0)
  /// A cap where the host can only serve so many at once. Null means no limit.
  dailyCapacity Int?

  /// Whether the host provides it themselves or a named partner does. Shown to
  /// the guest, because "who is picking me up" is a fair question.
  providerName String?

  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  listing  PropertyListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  addons   BookingAddon[]

  @@index([orgId, active])
  @@index([propertyId, active])
}

enum AddonStatus {
  /// Selected and paid for with the stay, awaiting the host arranging it.
  REQUESTED
  CONFIRMED
  DELIVERED
  CANCELLED
}

/// One service attached to one booking, priced when it was added.
model BookingAddon {
  id         String  @id @default(cuid())
  bookingId  String
  /// Nullable on purpose. Everything the guest agreed to is copied below, so a
  /// retired offering must not hold a booking hostage — nor, as `Restrict`
  /// did, make its whole organisation undeletable.
  offeringId String?

  /// Copied, not referenced. A host raising their transfer price next month
  /// must not change what a guest already agreed to pay.
  name      String
  kind      ServiceKind
  unitPrice Int
  quantity  Int         @default(1)
  amount    Int
  currency  String

  /// When the guest wants it, for things that happen at a time.
  scheduledFor DateTime?
  /// Flight number, pickup address, allergies — whatever the service needs.
  note         String?
  status       AddonStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offering ServiceOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([offeringId, status])
}

/// A single-use token for setting a new password.
///
/// The token itself is never stored — only its SHA-256 digest, exactly as
/// sessions are handled. A database that leaks reset rows must not hand
/// somebody a working link to every account in it.
model PasswordReset {
  id        String    @id @default(cuid())
  /// Digest of the token, never the token.
  tokenHash String    @unique
  /// Exactly one of these is set; a guest and a staff member are separate
  /// identities and a reset must not cross between them.
  userId    String?
  guestId   String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?

  @@index([expiresAt])
}

/// Where an earning is in its life. HELD and PAYABLE are money owed; PAID and
/// REVERSED are terminal, and reading them as owed is how a host gets paid
/// twice.
enum EarningStatus {
  HELD
  PAYABLE
  PAID
  REVERSED
}

enum PayoutStatus {
  PENDING
  SENT
  FAILED
}

/// What one booking earns its host, and what PALTAS keeps.
///
/// Written when the guest's payment succeeds, not when the booking is made: a
/// booking nobody has paid for owes nobody anything. Held until the stay has
/// finished, so there is money to refund from if the property is not what was
/// advertised — the guest's protection is the whole reason the platform, rather
/// than the host, takes the charge.
model HostEarning {
  id        String @id @default(cuid())
  orgId     String
  /// One earning per booking, enforced here rather than hoped for in code.
  bookingId String @unique

  /// Never converted. A payout carries one currency because a transfer does.
  currency    String
  /// What the guest paid.
  gross       Int
  /// What PALTAS keeps. Stored, not recomputed, so a later change to the fee
  /// rate cannot silently rewrite what a host was already owed.
  platformFee Int

  status   EarningStatus @default(HELD)
  /// The hold runs from here.
  checkOut DateTime

  payoutId   String?
  paidAt     DateTime?
  reversedAt DateTime?
  /// Set when money had already reached the host and had to be recovered.
  clawedBack Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payout  Payout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([status, checkOut])
}

/// One transfer to one host, in one currency.
///
/// The idempotency key is derived from the earnings being paid rather than from
/// the moment the run happened, so a run interrupted after Stripe accepted the
/// transfer but before these rows were written can be retried without paying
/// the same earnings again.
model Payout {
  id       String @id @default(cuid())
  orgId    String
  currency String
  amount   Int

  status           PayoutStatus @default(PENDING)
  stripeTransferId String?      @unique
  idempotencyKey   String       @unique
  failureReason    String?
  sentAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  earnings HostEarning[]

  @@index([orgId, createdAt])
}

enum EmailStatus {
  PENDING
  SENT
  /// Given up on. Either the address is not deliverable or the provider
  /// refused it enough times that retrying is just noise.
  FAILED
}

/// One row per thing that happened and deserved an email.
///
/// An outbox rather than a direct send, for the same reason payouts claim their
/// earnings before calling Stripe: the event and the notification must not be
/// able to disagree. The row is written in the same breath as the booking is
/// confirmed, so a process that dies before the provider answers leaves a
/// message to retry rather than a guest who was never told.
///
/// `dedupeKey` is derived from what happened — not from the time — so a Stripe
/// webhook delivered three times produces one confirmation email, and the
/// unique constraint is what guarantees it rather than a hopeful branch.
model EmailMessage {
  id        String @id @default(cuid())
  dedupeKey String @unique
  /// What kind of message this is: "booking.confirmed", "auth.reset", …
  kind      String
  to        String
  subject   String
  /// Both parts are rendered at enqueue time and stored. A template changed
  /// next month must not silently rewrite what a guest was sent last month,
  /// and a retry has to send the same message the first attempt would have.
  text      String
  html      String
  locale    String @default("en")

  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  /// Backoff: a transient failure waits before it is tried again.
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  sentAt        DateTime?
  /// The provider's own id, so a delivery can be traced without guessing.
  providerId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([kind, createdAt])
}

/// How many help-chat messages one caller has sent in one window.
///
/// The help assistant is an unauthenticated endpoint that calls a paid API, so
/// it will be found and scripted. This is what stands between that and an
/// invoice, and it is in the database rather than in memory so a restart or a
/// second instance does not reset somebody's allowance.
///
/// No message content is stored, and the caller is a salted digest rather than
/// an address: counting requests does not require keeping a record of everyone
/// who asked for help.
model SupportUsage {
  id          String   @id @default(cuid())
  callerHash  String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([callerHash, windowStart])
  @@index([windowStart])
}

/// A conversation between one marketplace guest and one host, or between a
/// guest and PALTAS itself.
///
/// Both sides of the platform can write to it, which is the whole point and
/// also the thing that makes it delicate: a Guest and a User are different
/// tables with different sessions, so a thread names one of each rather than
/// a single polymorphic "participant". `userId` is null on an official thread,
/// where the other side is PALTAS staff collectively rather than one person.
model MessageThread {
  id        String   @id @default(cuid())
  guestId   String
  /// The host. Null when this is a thread with PALTAS itself.
  userId    String?
  /// Which organisation the host side belongs to, so platform staff can answer
  /// an official thread without being a participant in it.
  orgId     String?
  /// What the conversation is about, when it started from a listing.
  listingId String?
  /// A PALTAS Support thread rather than a host one.
  official  Boolean  @default(false)
  subject   String?
  createdAt DateTime @default(now())
  /// Denormalised so the inbox can order threads without reading every message.
  lastMessageAt DateTime @default(now())

  guest    Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  listing  PropertyListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([guestId, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@index([official, lastMessageAt])
}

model Message {
  id       String   @id @default(cuid())
  threadId String
  body     String

  /// Exactly one of these is set — whichever side wrote it.
  senderGuestId String?
  senderUserId  String?

  /// Read receipts per side, rather than one flag, because "unread" means a
  /// different thing to each of them.
  readByGuestAt DateTime?
  readByUserAt  DateTime?

  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

enum NotificationKind {
  BOOKING
  APPROVAL
  VERIFICATION
  MESSAGE
  PRICE_DROP
  NEW_LISTING
  AVAILABILITY
  SYSTEM
}

/// Something the platform wants to tell one person about, in the product.
///
/// Deliberately addressed to one recipient rather than broadcast. A "new
/// property" row written once per listing and fanned out to every guest would
/// be a table that grows by inventory times audience, and most of it would
/// never be read. What everyone can see — newly published listings — is read
/// from the listings themselves; this table is only for what is true about
/// *you*: your booking, your approval, your documents.
model Notification {
  id       String           @id @default(cuid())
  /// Exactly one of these is set — the same two-sided audience messaging has.
  guestId  String?
  userId   String?
  kind     NotificationKind
  title    String
  body     String?
  /// Where tapping it should go. Null when there is nothing to open.
  href     String?
  /// What it concerns, so the same event cannot be recorded twice.
  entityId String?
  readAt   DateTime?
  createdAt DateTime @default(now())

  guest Guest? @relation(fields: [guestId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guestId, readAt, createdAt])
  @@index([userId, readAt, createdAt])
  @@unique([guestId, kind, entityId])
  @@unique([userId, kind, entityId])
}
